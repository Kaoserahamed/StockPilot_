# ==============================================================================
# StockPilot - root environment template
# Copy to `.env` (never commit the real file):
#     cp .env.example .env
# Every value below is a PLACEHOLDER. Generate real secrets locally.
# ==============================================================================

# ------------------------------------------------------------------------------
# PostgreSQL (used by docker-compose.dev.yml / docker-compose.prod.yml)
# ------------------------------------------------------------------------------
POSTGRES_DB=stockpilot
POSTGRES_USER=stockpilot
# REQUIRED. Generate with: openssl rand -base64 32
POSTGRES_PASSWORD=replace-with-a-strong-random-password

# ------------------------------------------------------------------------------
# Backend
# ------------------------------------------------------------------------------
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-strong-random-secret
ENVIRONMENT=development
LOG_LEVEL=INFO
JSON_LOGS=false

# Full SQLAlchemy URL used by the API.
# Local:      postgresql+psycopg2://stockpilot:<password>@localhost:5432/stockpilot
# Docker:     postgresql+psycopg2://stockpilot:<password>@db:5432/stockpilot
DATABASE_URL=postgresql+psycopg2://stockpilot:replace-with-a-strong-random-password@localhost:5432/stockpilot

# Comma-separated allowed browser origins. Use "*" for local development ONLY.
CORS_ORIGINS=http://localhost:3000

# Optional: Sentry DSN for backend crash reporting. Leave empty to keep the
# log-only tracker (errors still surface via /health/detailed).
SENTRY_DSN=

# ------------------------------------------------------------------------------
# Legacy MySQL helper (docker-compose.yml only - the app targets PostgreSQL)
# ------------------------------------------------------------------------------
# docker-compose.yml refuses to start without these; do not reuse them anywhere
# real, it is a throw-away local instance.
MYSQL_DATABASE=pos_saas
MYSQL_USER=pos_user
MYSQL_ROOT_PASSWORD=replace-with-a-strong-random-password
MYSQL_PASSWORD=replace-with-a-strong-random-password

# Optional: Gemini API key enables AI features. Leave blank to disable AI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# ------------------------------------------------------------------------------
# Frontend
# ------------------------------------------------------------------------------
# Base URL of the backend API. Must be reachable from the browser.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Environment mode. Next.js sets this automatically ('development' for
# `npm run dev`, 'production' for `npm run build`/`start`, 'test' for the
# Vitest suite); it is listed here only so a fresh clone sees every variable
# the codebase reads. Do not set it to 'production' locally by accident -
# that disables the Next.js dev overlays.
NODE_ENV=development

# ------------------------------------------------------------------------------
# Testing
# ------------------------------------------------------------------------------
# Backend pytest only: overrides the auto-generated default test password with a
# fixed value so test data is reproducible across runs. Not a real credential -
# tests run against an in-memory SQLite database. Leave blank to use a fresh
# cryptographically random token per process.
TEST_DEFAULT_PASSWORD=