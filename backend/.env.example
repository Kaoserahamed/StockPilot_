# =============================================================================
# StockPilot Backend - environment template
#
#   cp .env.example .env      then fill in the REQUIRED values below.
#
# Never commit the populated .env file.
# =============================================================================

# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_NAME=StockPilot - Inventory & POS SaaS
# development | staging | production
# In production the interactive /docs and /redoc pages are disabled.
ENVIRONMENT=development
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
# true emits one JSON object per log line (for collectors); false is human text.
JSON_LOGS=false

# -----------------------------------------------------------------------------
# Database (REQUIRED)
# -----------------------------------------------------------------------------
# Local PostgreSQL:
#   postgresql+psycopg2://user:password@localhost:5432/stockpilot
# Docker compose service:
#   postgresql+psycopg2://stockpilot:password@db:5432/stockpilot
# Legacy MySQL:
#   mysql+pymysql://user:password@localhost:3306/stockpilot
# Managed providers sometimes hand out `postgres://...`; the app normalises that.
DATABASE_URL=postgresql+psycopg2://stockpilot:change-me@localhost:5432/stockpilot

# Connection pool tuning (ignored for SQLite).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_RECYCLE=1800

# -----------------------------------------------------------------------------
# Security (REQUIRED)
# -----------------------------------------------------------------------------
# Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=change-me-to-a-long-random-secret

ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# -----------------------------------------------------------------------------
# CORS
# -----------------------------------------------------------------------------
# Comma-separated list of allowed browser origins.
# Use "*" for local development ONLY - never in production.
CORS_ORIGINS=http://localhost:3000

# -----------------------------------------------------------------------------
# Rate limiting
# -----------------------------------------------------------------------------
# Leave REDIS_URL empty to use in-process storage (single instance).
# Set it to share counters across replicas: redis://localhost:6379/0
REDIS_URL=
RATE_LIMIT_DEFAULT=100/minute
RATE_LIMIT_AUTH=5/minute

# -----------------------------------------------------------------------------
# File uploads
# -----------------------------------------------------------------------------
UPLOAD_DIR=./uploads

# -----------------------------------------------------------------------------
# AI (optional)
# -----------------------------------------------------------------------------
# Leave GEMINI_API_KEY empty to disable AI features; those endpoints return a
# graceful "AI unavailable" response instead of failing.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# -----------------------------------------------------------------------------
# Error tracking (optional)
# -----------------------------------------------------------------------------
# Sentry DSN for crash reporting and error aggregation.
# Leave empty to use log-only error tracking (still exposes errors via /health/detailed).
# When set, install sentry-sdk: pip install sentry-sdk
SENTRY_DSN=

# -----------------------------------------------------------------------------
# Testing
# -----------------------------------------------------------------------------
# Override the auto-generated test password for reproducible test runs.
# If not set, tests use a cryptographically secure random token.
# Only needed if you want deterministic test data across runs.
TEST_DEFAULT_PASSWORD=
